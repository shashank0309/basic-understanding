# Database (SQLite file for the prototype; switch provider in prisma/schema.prisma for Postgres)
DATABASE_URL="file:./dev.db"

# Branding (also editable in Admin > Settings)
CLIENT_NAME="Acme Pharma"
AI_FRAMEWORK_NAME="QualiAI"

# LLM provider: anthropic | azure | mock
# "mock" (default when no key is set) uses deterministic rule-based drafts so the demo works offline.
LLM_PROVIDER="mock"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"

# Azure OpenAI (production option)
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION="2024-10-21"
